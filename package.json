{
  "name": "agentbroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "test": "vitest run --config apps/desktop/vite.config.ts",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build --bundles app",
    "fixtures:generate": "node scripts/generate-demo.mjs",
    "tauri": "tauri",
    "test:fixtures": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.3",
    "lucide-react": "1.56.0",
    "@radix-ui/react-dialog": "1.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "@types/node": "24.10.1"
  }
}
