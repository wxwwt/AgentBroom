{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentBroom",
  "version": "0.1.0",
  "identifier": "io.github.wxwwt.agentbroom",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentBroom \u00b7 Read-only prototype",
        "width": 1260,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "shortDescription": "Read-only local Codex storage inventory"
  }
}
